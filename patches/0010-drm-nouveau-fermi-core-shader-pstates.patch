# Fermi (GF100-GF119): Core/shader reclocking, VID voltage fix, P-state 10 OC, and PCIe Gen1/Gen2 scaling
diff -ruN a/nvkm/subdev/clk/base.c b/nvkm/subdev/clk/base.c
--- a/nvkm/subdev/clk/base.c	2026-06-12 01:03:26.000000000 +0300
+++ b/nvkm/subdev/clk/base.c	2026-11-02 19:09:37.396595367 +0200
@@ -29,6 +29,7 @@
 #include <subdev/bios/perf.h>
 #include <subdev/bios/vpstate.h>
 #include <subdev/fb.h>
+#include <subdev/pci.h>
 #include <subdev/therm.h>
 #include <subdev/volt.h>
 
@@ -278,19 +279,37 @@
 	}
 
 	nvkm_debug(subdev, "setting performance state %d\n", pstatei);
-	clk->pstate = pstatei;
+	if (fb && fb->ram)
+		clk->pstate = pstatei;
+	else
+		clk->pstate = -1;
 
 	nvkm_pcie_set_link(pci, pstate->pcie_speed, pstate->pcie_width);
 
-	if (fb && fb->ram && fb->ram->func->calc) {
+	bool fermi_mem_reclock = nvkm_boolopt(subdev->device->cfgopt, "NvFermiMemReclock", false);
+	if (fb && fb->ram && fb->ram->func->calc && (subdev->device->card_type != NV_C0 || fermi_mem_reclock)) {
 		struct nvkm_ram *ram = fb->ram;
+		struct nvkm_volt *volt = subdev->device->volt;
 		int khz = pstate->base.domain[nv_clk_src_mem];
+
+		/* Raise voltage first if target pstate requires higher voltage */
+		if (volt) {
+			struct nvkm_cstate *cstate = !list_empty(&pstate->list) ?
+				nvkm_cstate_get(clk, pstate, NVKM_CLK_CSTATE_HIGHEST) : &pstate->base;
+			if (cstate)
+				nvkm_volt_set_id(volt, cstate->voltage, pstate->base.voltage, clk->temp, +1);
+		}
+
 		do {
 			ret = ram->func->calc(ram, khz);
 			if (ret == 0)
 				ret = ram->func->prog(ram);
 		} while (ret > 0);
 		ram->func->tidy(ram);
+		if (ret < 0) {
+			nvkm_error(subdev, "failed to reclock memory to %d kHz: %d\n", khz, ret);
+			return ret;
+		}
 	}
 
 	return nvkm_cstate_prog(clk, pstate, NVKM_CLK_CSTATE_HIGHEST);
@@ -428,6 +447,12 @@
 	pstate->pcie_width = perfE.pcie_width;
 	cstate = &pstate->base;
 	cstate->voltage = perfE.voltage;
+	/* Class A (universal boards): trust VBIOS voltage first. GF106M
+	 * L702X VBIOS undervolts 0f (862.5 mV vs factory 1.030 V VID 0x01),
+	 * so raise to 0x67 only when VBIOS asks for less. Other boards
+	 * (e.g. GF119M 410M) keep their own factory VID untouched. */
+	if (pstate->pstate == 0x0f && perfE.voltage < 0x67)
+		cstate->voltage = 0x67;
 	cstate->domain[nv_clk_src_core] = perfE.core;
 	cstate->domain[nv_clk_src_shader] = perfE.shader;
 	cstate->domain[nv_clk_src_mem] = perfE.memory;
@@ -451,6 +476,9 @@
 
 		cstate->domain[domain->name] = perfS.v40.freq;
 	}
+	/* shader = hot clock (2x core) if VBIOS omits it */
+	if (!cstate->domain[nv_clk_src_shader])
+		cstate->domain[nv_clk_src_shader] = cstate->domain[nv_clk_src_gpc];
 
 	data = nvbios_cstepEm(bios, pstate->pstate, &ver, &hdr, &cstepE);
 	if (data) {
@@ -463,6 +491,35 @@
 	nvkm_pstate_info(clk, pstate);
 	list_add_tail(&pstate->head, &clk->states);
 	clk->state_nr++;
+
+	/* Local OC pstate (beyond BIOS max 0f) — gated by NvFermiOC.
+	 * Class A: scale relative to the board's own 0f (+~18%, same ratio
+	 * as GF106M 590->700) instead of absolute 1400 MHz, so low-clock
+	 * boards (e.g. GF119M 410M 573 MHz -> ~676 MHz) stay safe. */
+	if (pstate->pstate == 0x0f && nvkm_boolopt(clk->subdev.device->cfgopt, "NvFermiOC", false)) {
+		struct nvkm_pstate *oc = kzalloc(sizeof(*oc), GFP_KERNEL);
+		if (oc) {
+			u32 base_core, base_shader;
+			INIT_LIST_HEAD(&oc->list);
+			oc->pstate = 0x10;
+			oc->fanspeed = pstate->fanspeed;
+			oc->pcie_speed = pstate->pcie_speed;
+			oc->pcie_width = pstate->pcie_width;
+			oc->base = pstate->base;
+			base_core = pstate->base.domain[nv_clk_src_gpc];
+			base_shader = pstate->base.domain[nv_clk_src_shader];
+			if (!base_core)
+				base_core = pstate->base.domain[nv_clk_src_core];
+			if (!base_shader)
+				base_shader = base_core * 2;
+			oc->base.domain[nv_clk_src_gpc] = base_core + base_core / 5;
+			oc->base.domain[nv_clk_src_shader] = base_shader + base_shader / 5;
+			nvkm_pstate_info(clk, oc);
+			list_add_tail(&oc->head, &clk->states);
+			clk->state_nr++;
+		}
+	}
+
 	return 0;
 }
 
@@ -524,6 +581,7 @@
 	if (ret >= 0) {
 		if (ret -= 2, pwr) clk->ustate_ac = ret;
 		else		   clk->ustate_dc = ret;
+		clk->pstate = -1;
 		return nvkm_pstate_calc(clk, true);
 	}
 	return ret;
@@ -555,6 +613,7 @@
 	if ( rel) clk->dstate += rel;
 	clk->dstate = min(clk->dstate, clk->state_nr - 1);
 	clk->dstate = max(clk->dstate, 0);
+	clk->pstate = -1;
 	return nvkm_pstate_calc(clk, true);
 }
 
@@ -590,6 +649,7 @@
 nvkm_clk_init(struct nvkm_subdev *subdev)
 {
 	struct nvkm_clk *clk = nvkm_clk(subdev);
+	struct nvkm_pci *pci = subdev->device->pci;
 	const struct nvkm_domain *clock = clk->domains;
 	int ret;
 
@@ -612,11 +672,40 @@
 	if (clk->func->init)
 		return clk->func->init(clk);
 
+	/* Synchronize initial PCIe link speed to match boot performance state on cold boot */
+	if (pci && (int)pci->pcie.speed == -1) {
+		struct nvkm_pstate *pstate, *boot_pstate = NULL;
+		list_for_each_entry(pstate, &clk->states, head) {
+			u32 core = pstate->base.domain[nv_clk_src_core];
+			u32 mem = pstate->base.domain[nv_clk_src_mem];
+			u32 bcore = clk->bstate.base.domain[nv_clk_src_core];
+			u32 bmem = clk->bstate.base.domain[nv_clk_src_mem];
+			u32 cdiff = (core > bcore) ? (core - bcore) : (bcore - core);
+			u32 mdiff = (mem > bmem) ? (mem - bmem) : (bmem - mem);
+
+			if (cdiff < 15000 && mdiff < 15000) {
+				boot_pstate = pstate;
+				break;
+			}
+		}
+		if (!boot_pstate) {
+			list_for_each_entry(pstate, &clk->states, head) {
+				if (pstate->pstate == 0x07) {
+					boot_pstate = pstate;
+					break;
+				}
+			}
+		}
+		if (boot_pstate)
+			nvkm_pcie_set_link(pci, boot_pstate->pcie_speed, boot_pstate->pcie_width);
+	}
+
 	clk->astate = clk->state_nr - 1;
 	clk->dstate = 0;
 	clk->pstate = -1;
 	clk->temp = 90; /* reasonable default value */
 	nvkm_pstate_calc(clk, true);
+	clk->pstate = -1;
 	return 0;
 }
 
