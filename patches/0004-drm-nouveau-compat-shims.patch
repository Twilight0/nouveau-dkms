# Universal: Multi-kernel compatibility layer (Linux 6.18 through 7.3)
diff -ruN a/nouveau_compat.h b/nouveau_compat.h
--- a/nouveau_compat.h	1970-01-01 00:00:00.000000000 +0000
+++ b/nouveau_compat.h	2026-11-02 19:30:00.000000000 +0200
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef __NOUVEAU_COMPAT_H__
+#define __NOUVEAU_COMPAT_H__
+
+#include <linux/version.h>
+#include <linux/mm.h>
+#include <linux/memremap.h>
+#include <linux/dma-fence.h>
+
+#include <drm/drm_print.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_client.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_uapi.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_atomic_state_helper.h>
+#include <drm/drm_gpuvm.h>
+#include <drm/gpu_scheduler.h>
+#include <drm/ttm/ttm_bo.h>
+#include <drm/ttm/ttm_device.h>
+
+/*
+ * Linux 6.18.55+ / 6.19+ compatibility shims
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 55)
+#define drm_client_dev_suspend(dev, ...) drm_client_dev_suspend(dev)
+#define drm_client_dev_resume(dev, ...)  drm_client_dev_resume(dev)
+#endif
+
+/*
+ * Linux 6.19+ compatibility shims
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 19, 0)
+#define ttm_bo_put(bo) ttm_bo_fini(bo)
+
+#define ttm_device_init(bdev, funcs, dev, mapping, vma_mgr, use_dma, use_dma32) \
+	ttm_device_init((bdev), (funcs), (dev), (mapping), (vma_mgr), \
+			((use_dma) ? TTM_ALLOCATION_POOL_USE_DMA_ALLOC : 0) | \
+			((use_dma32) ? TTM_ALLOCATION_POOL_USE_DMA32 : 0))
+
+#define zone_device_page_init(page) \
+	zone_device_page_init((page), page_pgmap(page), 0)
+#endif
+
+/*
+ * Linux 7.0+ compatibility shims
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+#define drm_gpuvm_bo_obtain(gpuvm, obj) drm_gpuvm_bo_obtain_locked((gpuvm), (obj))
+#endif
+
+/*
+ * Linux 7.2+ compatibility shims
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+#define drm_atomic_state                 drm_atomic_commit
+#define drm_atomic_state_alloc           drm_atomic_commit_alloc
+#define drm_atomic_state_get             drm_atomic_commit_get
+#define drm_atomic_state_put             drm_atomic_commit_put
+#define drm_atomic_state_clear           drm_atomic_commit_clear
+#define drm_atomic_state_init            drm_atomic_commit_init
+#define drm_atomic_state_default_clear   drm_atomic_commit_default_clear
+#define drm_atomic_state_default_release drm_atomic_commit_default_release
+
+#define drm_sched_entity_fini(entity)    drm_sched_entity_kill(entity)
+#endif
+
+/*
+ * Linux 7.3+ compatibility shims
+ */
+#ifndef DRIVER_GEM_GPUVA
+#define DRIVER_GEM_GPUVA 0
+#endif
+
+#endif /* __NOUVEAU_COMPAT_H__ */
