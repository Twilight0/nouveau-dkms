diff -ruN a/dispnv04/crtc.c b/dispnv04/crtc.c
--- a/dispnv04/crtc.c	2026-06-12 01:03:26.000000000 +0300
+++ b/dispnv04/crtc.c	2026-11-02 19:30:50.873910893 +0200
@@ -923,6 +923,7 @@
 	return nv04_crtc_do_mode_set_base(crtc, old_fb, x, y, false);
 }
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 0, 0)
 static int
 nv04_crtc_mode_set_base_atomic(struct drm_crtc *crtc,
 			       struct drm_framebuffer *fb,
@@ -930,6 +931,7 @@
 {
 	return nv04_crtc_do_mode_set_base(crtc, fb, x, y, true);
 }
+#endif
 
 static void nv04_cursor_upload(struct drm_device *dev, struct nouveau_bo *src,
 			       struct nouveau_bo *dst)
@@ -1274,7 +1276,9 @@
 	.commit = nv_crtc_commit,
 	.mode_set = nv_crtc_mode_set,
 	.mode_set_base = nv04_crtc_mode_set_base,
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 0, 0)
 	.mode_set_base_atomic = nv04_crtc_mode_set_base_atomic,
+#endif
 	.disable = nv_crtc_disable,
 	.get_scanout_position = nouveau_display_scanoutpos,
 };
diff -ruN a/nouveau_dmem.c b/nouveau_dmem.c
--- a/nouveau_dmem.c	2026-06-12 01:03:26.000000000 +0300
+++ b/nouveau_dmem.c	2026-11-02 19:30:50.874183374 +0200
@@ -219,8 +219,19 @@
 	return ret;
 }
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 19, 0)
+static void nouveau_dmem_folio_free(struct folio *folio)
+{
+	nouveau_dmem_page_free(&folio->page);
+}
+#endif
+
 static const struct dev_pagemap_ops nouveau_dmem_pagemap_ops = {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 19, 0)
+	.folio_free		= nouveau_dmem_folio_free,
+#else
 	.page_free		= nouveau_dmem_page_free,
+#endif
 	.migrate_to_ram		= nouveau_dmem_migrate_to_ram,
 };
 
diff -ruN a/nouveau_drm.c b/nouveau_drm.c
--- a/nouveau_drm.c	2026-06-12 01:03:26.000000000 +0300
+++ b/nouveau_drm.c	2026-11-02 19:30:50.874433542 +0200
@@ -156,6 +156,16 @@
 static inline bool
 nouveau_cli_work_ready(struct dma_fence *fence)
 {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+	unsigned long flags;
+
+	if (!dma_fence_is_signaled(fence))
+		return false;
+	dma_fence_lock_irqsave(fence, flags);
+	dma_fence_unlock_irqrestore(fence, flags);
+	dma_fence_put(fence);
+	return true;
+#else
 	bool ret = true;
 
 	spin_lock_irq(fence->lock);
@@ -166,6 +176,7 @@
 	if (ret == true)
 		dma_fence_put(fence);
 	return ret;
+#endif
 }
 
 static void
diff -ruN a/nouveau_fence.c b/nouveau_fence.c
--- a/nouveau_fence.c	2026-06-12 01:03:26.000000000 +0300
+++ b/nouveau_fence.c	2026-11-02 19:30:50.874609983 +0200
@@ -41,7 +41,11 @@
 static inline struct nouveau_fence_chan *
 nouveau_fctx(struct nouveau_fence *fence)
 {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+	return container_of(fence->base.extern_lock, struct nouveau_fence_chan, lock);
+#else
 	return container_of(fence->base.lock, struct nouveau_fence_chan, lock);
+#endif
 }
 
 static bool
