+/* SPDX-License-Identifier: MIT */
+#ifndef __NVKM_QUIRKS_H__
+#define __NVKM_QUIRKS_H__
+
+#include <linux/types.h>
+
+/*
+ * Hardware and OEM Subsystem Quirks
+ *
+ * Board-level workarounds and policy overrides matching PCI Subsystem IDs
+ * (subvendor:subdevice) to prevent OEM-specific wiring, panels, or power
+ * topologies from causing regressions across different machines sharing
+ * the same GPU silicon.
+ */
+
+/* Quirk policy flags */
+#define NOUVEAU_QUIRK_FORCE_DISPCLK_FLOOR    BIT(0) /* Needs dispclk >= 405 MHz (120 Hz eDP) */
+#define NOUVEAU_QUIRK_OPTIMUS_MUXLESS        BIT(1) /* Render-offload only; NVIDIA display engine unclocked */
+#define NOUVEAU_QUIRK_DDR3_3PARTITION        BIT(2) /* 192-bit DDR3 memory layout (3 FB partitions) */
+#define NOUVEAU_QUIRK_DDR3_1PARTITION        BIT(3) /* 64-bit DDR3 memory layout (1 FB partition) */
+#define NOUVEAU_QUIRK_SKIP_GDDR5_TRAINING    BIT(4) /* Mobile Kepler DDR3 link training bypass */
+#define NOUVEAU_QUIRK_DELL_SMM_THERMAL       BIT(5) /* Dell SMM shared blower fan and thermal profile */
+#define NOUVEAU_QUIRK_PANEL_TOLERANCE_5MHZ   BIT(6) /* 3D Vision panel pixel clock tolerance bypass */
+
+struct nvkm_device;
+
+struct nvkm_device_quirk {
+	u8 tv_pin_mask;
+	u8 tv_gpio;
+	u32 flags;
+	u32 min_dispclk_khz;
+	u8 fb_partitions;
+	const char *desc;
+};
+
+static inline bool
+nvkm_has_quirk(const struct nvkm_device *device, u32 flag)
+{
+	return device && device->quirk && (device->quirk->flags & flag);
+}
+
+#endif
