+	u32 hi = ram->ddr3_hi ? ram->ddr3_hi : 900000;
+
+	return gf100_ram_fexec_run(ram, fexec_code, ARRAY_SIZE(fexec_code),
+				   freq == hi ? 1 : 2, freq, true);
+}
+
+/******************************************************************************
+ * Quadro 600 (GF108 / NVC1, 10de:0df8 103c:0835, VBIOS 70.08.2a.00.01)
+ *
+ * Replays NVIDIA 390.157's own PMU memx scripts captured on this card
+ * (docs/research/GF108_QUADRO600.md, testing/gf108_*) through the resident
+ * executor: cmd 1 = block 28 (324 MPLL -> 800 MPLL), cmd 2 = "to 324": the
+ * executor runs block 20 (boot 324 on the mdiv bypass -> 324 on MPLL) when
+ * 0x137360 bit 0 is set, block 54 (800 -> 324 MPLL) when it is clear.
+ * Every transition is gated on the exact register state the capture
+ * started from.
+ *****************************************************************************/
+enum gf100_q600_state {
+	Q600_UNKNOWN = 0,
+	Q600_BOOT324,	/* devinit: mdiv 1620/5 (0x137310 0x0808), MPLL off */
+	Q600_MPLL324,	/* after block 20 (0x137310 0x0808) or block 54 (0x0608):
+			 * MPLL 405*24/6/5 */
+	Q600_MPLL800,	/* after block 28: MPLL 405*47/8/3 = 793 MHz */
+};
+
+static const char * const gf100_q600_state_name[] = {
+	"unknown", "boot-324 (mdiv)", "324 (MPLL)", "800 (MPLL)",
+};
+
+static enum gf100_q600_state
+gf100_ram_q600_state(struct nvkm_device *device)
+{
+	u32 r132000 = nvkm_rd32(device, 0x132000);
+	u32 r132004 = nvkm_rd32(device, 0x132004);
+	u32 r137300 = nvkm_rd32(device, 0x137300);
+	u32 r137310 = nvkm_rd32(device, 0x137310);
+	u32 r137320 = nvkm_rd32(device, 0x137320);
+	u32 r137330 = nvkm_rd32(device, 0x137330);
+	u32 r137360 = nvkm_rd32(device, 0x137360);
+
+	if (r137300 != 0x00000103 || r137320 != 0x00000103 || r137330 != 0x81200606)
+		return Q600_UNKNOWN;
+	if ((r137360 & 3) == 3 && r132000 == 0x18010002 && r137310 == 0x81200808)
+		return Q600_BOOT324;
+	if ((r137360 & 3) == 2 && (r132000 & 0x00000001) && r132004 == 0x00051806 &&
+	    (r137310 == 0x81200808 || r137310 == 0x81200608))
+		return Q600_MPLL324;
+	if ((r137360 & 3) == 2 && (r132000 & 0x00000001) && r132004 == 0x00032f08 &&
+	    r137310 == 0x81200608)
+		return Q600_MPLL800;
+	return Q600_UNKNOWN;
+}
+
+static void
+gf100_ram_q600_dump(struct nvkm_subdev *subdev, const char *why)
+{
+	struct nvkm_device *device = subdev->device;
+
+	nvkm_error(subdev, "DDR3: Q600 %s: 132000=%08x 132004=%08x 137300=%08x 137310=%08x 137320=%08x 137330=%08x 137360=%08x 137390=%08x 10f200=%08x 10f290=%08x\n",
+		   why, nvkm_rd32(device, 0x132000), nvkm_rd32(device, 0x132004),
+		   nvkm_rd32(device, 0x137300), nvkm_rd32(device, 0x137310),
+		   nvkm_rd32(device, 0x137320), nvkm_rd32(device, 0x137330),
+		   nvkm_rd32(device, 0x137360), nvkm_rd32(device, 0x137390),
+		   nvkm_rd32(device, 0x10f200), nvkm_rd32(device, 0x10f290));
+}
+
+/* Board facts the captured scripts depend on; checked once, before the
+ * first transition.  A mismatch downgrades the board to "no script". */
+static bool
+gf100_ram_q600_check(struct gf100_ram *ram)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct nvkm_bios *bios = device->bios;
+	u32 strap = (nvkm_rd32(device, 0x101000) & 0x0000003c) >> 2;
+	u32 fbpas = nvkm_rd32(device, 0x02243c);
+	u32 fbpam = nvkm_rd32(device, 0x022550);
+
+	if (bios->version.major != 0x70 || bios->version.chip != 0x08 ||
+	    bios->version.minor != 0x2a || bios->version.micro != 0x00 ||
+	    bios->version.patch != 0x01) {
+		nvkm_info(subdev, "DDR3: Q600 script is for VBIOS 70.08.2a.00.01, this is %02x.%02x.%02x.%02x.%02x\n",
+			  bios->version.major, bios->version.chip, bios->version.minor,
+			  bios->version.micro, bios->version.patch);
+		return false;
+	}
+	if (strap != 3 || fbpas != 2 || (fbpam & 3)) {
+		nvkm_info(subdev, "DDR3: Q600 script is for strap 3 / 2 FBPAs, this is strap %u / %u FBPAs (mask %08x)\n",
+			  strap, fbpas, fbpam);
+		return false;
+	}
+	if (ram->ddr3_lo != 324000 || ram->ddr3_hi != 800000) {
+		nvkm_info(subdev, "DDR3: Q600 script is for the 324/800 MHz pair, VBIOS gives %u/%u kHz\n",
+			  ram->ddr3_lo, ram->ddr3_hi);
+		return false;
+	}
+	return true;
+}
+
+static int
+gf100_ram_q600_run(struct gf100_ram *ram, u32 cmd, u32 freq,
+		   enum gf100_q600_state want)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	enum gf100_q600_state st;
+	int ret;
+
+	nvkm_info(subdev, "DDR3: Q600 cmd %u (%s) -> %s\n", cmd,
+		  cmd == 1 ? "NVIDIA block 28" :
+		  cmd == 2 ? (want == Q600_MPLL324 &&
+			      (nvkm_rd32(device, 0x137360) & 1) ? "NVIDIA block 20" :
+			      "NVIDIA block 54") : "probe",
+		  gf100_q600_state_name[want]);
+	ret = gf100_ram_fexec_run(ram, fexec_code_gf108, ARRAY_SIZE(fexec_code_gf108),
+				  cmd, freq, false);
+	st = gf100_ram_q600_state(device);
+	if (ret) {
+		/* SCRATCH2 0xDEAD0020: PLL lock timeout before the FB block,
+		 * DRAM untouched; 0xDEAD0108: failure inside the block, FB
+		 * pause released and engine gating restored by the executor;
+		 * 0xDEAD0000: MMIO-port timeout inside a helper, state unknown. */
+		gf100_ram_q600_dump(subdev, "transition failed");
+		return ret;
+	}
+	if (st != want) {
+		gf100_ram_q600_dump(subdev, "unexpected state after transition");
+		return -EIO;
+	}
+	return 0;
+}
+
+static int
+gf100_ram_calc_q600(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	enum gf100_q600_state st;
+	int ret;
+
+	/* clk/base.c only calls us with NvFermiMemReclock=true; belt and braces. */
+	if (!nvkm_boolopt(device->cfgopt, "NvFermiMemReclock", false))
+		return 0;
+
+	if (!gf100_ram_q600_check(ram)) {
+		ram->ddr3_board = GF100_DDR3_NONE;
+		nvkm_info(subdev, "DDR3: memory reclock disabled for this board, memory stays as booted\n");
+		return 0;
+	}
+
+	if (freq == 135000)	/* pstate 03 asks 135, same 324 MHz memory state */
+		freq = 324000;
+	if (freq != 324000 && freq != 800000) {
+		nvkm_info(subdev, "DDR3: Q600 has no script for %u kHz, memory untouched\n", freq);
+		return 0;
+	}
+
+	st = gf100_ram_q600_state(device);
+	if (st == Q600_UNKNOWN) {
+		gf100_ram_q600_dump(subdev, "memory clock state not one of the captured ones, refusing");
+		return -EIO;
+	}
+
+	if (freq == 324000) {
+		switch (st) {
+		case Q600_BOOT324:
+			if (nvkm_boolopt(device->cfgopt, "NvFermiMemDryRun", false)) {
+				nvkm_info(subdev, "DDR3: Q600 dry run 324 -> 324 (boot mdiv -> MPLL, full self-refresh/MRS cycle)\n");
+				return gf100_ram_q600_run(ram, 2, 324000, Q600_MPLL324);
+			}
+			fallthrough;
+		case Q600_MPLL324:
+			if (!fexec_resident_running &&
+			    nvkm_boolopt(device->cfgopt, "NvFermiMemProbe", false)) {
+				nvkm_info(subdev, "DDR3: Q600 executor probe (cmd 0, no memory writes)\n");
+				return gf100_ram_q600_run(ram, 0, 0, st);
+			}
+			nvkm_debug(subdev, "DDR3: Q600 memory already at 324 MHz (%s)\n",
+				   gf100_q600_state_name[st]);
+			return 0;
+		default:	/* Q600_MPLL800: cmd 2 runs block 54 (0x137360 bit 0 clear) */
+			return gf100_ram_q600_run(ram, 2, 324000, Q600_MPLL324);
+		}
+	}
+
+	/* freq == 800000 */
+	if (st == Q600_MPLL800) {
+		nvkm_debug(subdev, "DDR3: Q600 memory already at 800 MHz\n");
+		return 0;
+	}
+	if (st == Q600_BOOT324) {
+		/* block 28 starts from MPLL-324: go there first (block 20) */
+		ret = gf100_ram_q600_run(ram, 2, 324000, Q600_MPLL324);
+		if (ret)
+			return ret;
+	}
+	/* Either MPLL-324 form: block 28's first write (0x137310 = 0x81200608)
+	 * is a no-op on the post-54 form, which is exactly NVIDIA's block 61. */
+	return gf100_ram_q600_run(ram, 1, 800000, Q600_MPLL800);
+}
+
 static int
 gf100_ram_calc_ddr3(struct gf100_ram *ram, u32 freq)
 {
@@ -584,6 +817,8 @@
 	switch (ram->ddr3_board) {
 	case GF100_DDR3_L702X:
 		break;
+	case GF100_DDR3_Q600:
+		return gf100_ram_calc_q600(ram, freq);
 	default:
 		if (!ram->ddr3_skip_logged) {
 			nvkm_info(subdev, "DDR3: no executor script for this board (chip %02x), memory stays at %u kHz\n",
@@ -1207,8 +1442,13 @@
 		    pdev->device == 0x0dcd && pdev->subsystem_vendor == 0x1028 &&
 		    pdev->subsystem_device == 0x04b7)
 			ram->ddr3_board = GF100_DDR3_L702X;
+		else if (device->chipset == 0xc1 && pdev->vendor == 0x10de &&
+			 pdev->device == 0x0df8 && pdev->subsystem_vendor == 0x103c &&
+			 pdev->subsystem_device == 0x0835)
+			ram->ddr3_board = GF100_DDR3_Q600;
 		nvkm_info(subdev, "DDR3: memory reclock script: %s\n",
 			  ram->ddr3_board == GF100_DDR3_L702X ? "GF106M L702X" :
+			  ram->ddr3_board == GF100_DDR3_Q600 ? "Quadro 600 (NVIDIA 390.157 capture)" :
 			  "none (memory reclock skipped)");
 	}
 
