#!/usr/bin/make -f
VERSION := $(shell dpkg-parsechangelog -S Version | cut -d- -f1)

%:
	dh $@

override_dh_auto_build:
	mkdir -p build/nouveau-dkms-$(VERSION)
	tar -xzf nouveau-source.tar.gz -C build/
	patch -Np1 -d build/nouveau-source < nouveau.patch
	cp -r build/nouveau-source/* build/nouveau-dkms-$(VERSION)/
	sed 's/@PKGVER@/$(VERSION)/g' dkms.conf > build/nouveau-dkms-$(VERSION)/dkms.conf

override_dh_auto_install:
	install -d debian/nouveau-dkms/usr/src/nouveau-dkms-$(VERSION)
	cp -r build/nouveau-dkms-$(VERSION)/* debian/nouveau-dkms/usr/src/nouveau-dkms-$(VERSION)/
	install -Dm644 nouveau.conf debian/nouveau-dkms/etc/modprobe.d/nouveau.conf

override_dh_clean:
	dh_clean
	rm -rf build/
