#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	mkdir -p build/nouveau-dkms-2.2.0
	tar -xzf nouveau-source.tar.gz -C build/
	patch -Np1 -d build/nouveau-source < nouveau.patch
	cp -r build/nouveau-source/* build/nouveau-dkms-2.2.0/
	sed 's/@PKGVER@/2.2.0/g' dkms.conf > build/nouveau-dkms-2.2.0/dkms.conf

override_dh_auto_install:
	install -d debian/nouveau-dkms/usr/src/nouveau-dkms-2.2.0
	cp -r build/nouveau-dkms-2.2.0/* debian/nouveau-dkms/usr/src/nouveau-dkms-2.2.0/
	install -Dm644 nouveau.conf debian/nouveau-dkms/etc/modprobe.d/nouveau.conf

override_dh_clean:
	dh_clean
	rm -rf build/
